POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha
POSTGRES_DB=nome_do_banco
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/nome_do_banco
SPORTS_API_BASE_URL=https://sandbox.exemplo.com
SPORTS_API_KEY=adicione_sua_chave
SPORTS_API_TIMEOUT=15
SPORTS_API_MAX_RETRIES=3
SPORTS_API_RETRY_DELAY=1
SPORTS_API_SANDBOX=true

SCHEDULER_HEARTBEAT_SECONDS=30
SCHEDULER_OFFLINE_AFTER_SECONDS=90
SCHEDULER_INSTANCE_NAME=ultrastats-main
# Configurações específicas do ambiente Docker
DASHBOARD_PORT=8501
DOCKER_SCHEDULER_INSTANCE_NAME=ultrastats-docker

# Logging
LOG_LEVEL=INFO
LOG_DIRECTORY=logs
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
LOG_CONSOLE_ENABLED=true
LOG_FILE_ENABLED=true

# Providers
PROVIDER_HTTP_TIMEOUT_SECONDS=15
PROVIDER_HTTP_MAX_RETRIES=3
PROVIDER_HTTP_RETRY_DELAY_SECONDS=1
PROVIDER_DEFAULT_REQUESTS_PER_MINUTE=10
PROVIDER_USER_AGENT=UltraStats-AI/1.0