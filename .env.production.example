ULTRASTATS_BACKEND_IMAGE=ghcr.io/owner/ultrastats-ai-backend:0.1.0
ULTRASTATS_FRONTEND_IMAGE=ghcr.io/owner/ultrastats-ai-frontend:0.1.0
APP_DOMAIN=app.example.com
POSTGRES_USER=ultrastats_production
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=ultrastats_production
DATABASE_URL=postgresql+psycopg://ultrastats_production:replace-with-a-long-random-password@postgres:5432/ultrastats_production
TOKEN_SIGNING_SECRET=replace-with-at-least-32-random-characters

FOOTBALL_DATA_API_TOKEN=replace-with-production-provider-token
API_FOOTBALL_KEY=replace-with-production-api-sports-key
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
OPENLIGADB_BASE_URL=https://api.openligadb.de
FOOTBALL_DATA_UK_BASE_URL=https://www.football-data.co.uk
STATSBOMB_OPEN_DATA_BASE_URL=https://raw.githubusercontent.com/statsbomb/open-data/master/data
PROVIDER_PRIORITY=api_football,football_data,statsbomb_open_data,football_data_uk,openligadb

SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=60
SYNC_PROVIDER=multi_provider
SYNC_MAX_RUNTIME_MINUTES=15
LIVE_SYNC_INTERVAL_SECONDS=60
BACKFILL_ENABLED=true
BACKFILL_SEPARATE_WORKER=true
BACKFILL_INTERVAL_MINUTES=10
AUTO_BACKFILL_REQUESTS_PER_CYCLE=2500
ODDS_SYNC_ENABLED=true
ODDS_SYNC_INTERVAL_MINUTES=15
ODDS_SYNC_WINDOW_DAYS=14
API_FOOTBALL_MIN_REMAINING=10000
SCHEDULER_HEARTBEAT_SECONDS=30
SCHEDULER_OFFLINE_AFTER_SECONDS=90
SCHEDULER_INSTANCE_NAME=ultrastats-production
AUTO_CORE_WINDOW_DAYS=30
AUTO_CORE_SUSTAIN_DAYS=7
AUTO_CORE_MIN_FINISHED_MATCHES=20
AUTO_CORE_MIN_ODDS_MATCHES=5
AUTO_CORE_STATISTICS_COVERAGE=0.90
AUTO_CORE_ODDS_COVERAGE=0.80
TEMPORAL_ML_MAXIMUM_SAMPLES=5000
PLAYER_IMPACT_ENABLED=true
PLAYER_IMPACT_MIN_COVERAGE=0.45
PLAYER_IMPACT_MAX_XG_ADJUSTMENT=0.12
LOG_LEVEL=INFO
LOG_DIRECTORY=/app/logs
LOG_CONSOLE_ENABLED=true
LOG_FILE_ENABLED=true

OPENLIGADB_LEAGUE=bl1
OPENLIGADB_SEASON=2025
FOOTBALL_DATA_UK_PATH=mmz4281/2526/E0.csv
BACKFILL_EMPTY_RETRY_HOURS=24
BACKFILL_MAX_EMPTY_ATTEMPTS=5
PAPER_TRADING_ENABLED=true
PAPER_TRADING_INTERVAL_MINUTES=5
PAPER_TRADING_INITIAL_BALANCE=10000
PAPER_TRADING_CREATION_BATCH_SIZE=500
PAPER_TRADING_SETTLEMENT_BATCH_SIZE=500
PAPER_TRADING_BACKFILL_DAYS=14
PAPER_ML_RETRAIN_SETTLEMENTS=100
PAPER_POLICY_MIN_SEGMENT_SAMPLES=100
TEMPORAL_ML_MIN_RELATIVE_IMPROVEMENT=0.01
PREDICTION_REFRESH_BATCH_SIZE=250
PREDICTION_REFRESH_ROTATION_MINUTES=15
PROVIDER_RATE_LIMIT_RETRIES=3
DATA_RETENTION_ENABLED=false
ODDS_SNAPSHOT_RETENTION_DAYS=180
RECOMMENDATION_RETENTION_DAYS=365
RETENTION_DELETE_BATCH_SIZE=10000
