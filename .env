POSTGRES_USER=ultrastats
POSTGRES_PASSWORD=ultrastats123
POSTGRES_DB=ultrastats_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://ultrastats:ultrastats123@localhost:5432/ultrastats_db
SPORTS_API_BASE_URL=https://sandbox.exemplo.com
SPORTS_API_KEY=chave_de_teste
SPORTS_API_TIMEOUT=15
SPORTS_API_MAX_RETRIES=3
SPORTS_API_RETRY_DELAY=1
SPORTS_API_SANDBOX=true

SYNC_ENABLED=true

SYNC_INTERVAL_MINUTES=60

SYNC_PROVIDER=mock_provider

SYNC_MAX_RUNTIME_MINUTES=20
LIVE_SYNC_INTERVAL_SECONDS=60
BACKFILL_ENABLED=true
BACKFILL_SEPARATE_WORKER=true
BACKFILL_INTERVAL_MINUTES=10
AUTO_BACKFILL_REQUESTS_PER_CYCLE=2500
ODDS_SYNC_ENABLED=true
ODDS_SYNC_INTERVAL_MINUTES=15
ODDS_SYNC_WINDOW_DAYS=14
API_FOOTBALL_MIN_REMAINING=10000

SCHEDULER_HEARTBEAT_SECONDS=30
SCHEDULER_OFFLINE_AFTER_SECONDS=90
SCHEDULER_INSTANCE_NAME=ultrastats-main

# Logging
LOG_LEVEL=INFO
LOG_DIRECTORY=logs
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
LOG_CONSOLE_ENABLED=true
LOG_FILE_ENABLED=true

# Providers
PROVIDER_NAME=mock
PROVIDER_HTTP_TIMEOUT_SECONDS=15
PROVIDER_HTTP_MAX_RETRIES=3
PROVIDER_HTTP_RETRY_DELAY_SECONDS=1
PROVIDER_DEFAULT_REQUESTS_PER_MINUTE=10
PROVIDER_USER_AGENT=UltraStats-AI/1.0
